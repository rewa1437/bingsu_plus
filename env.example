# ============================================
# Bingsu - Environment Variables
# ============================================
# Copy this file to .env or .env.local and fill in your values
# For local development, use .env.local (git-ignored)

# ============================================
# Server Configuration
# ============================================

# Environment: "development" or "production"
ENV="development"

# Server Host and Port
HOST="0.0.0.0"
PORT="8000"

# Enable GZip compression (true/false)
ENABLE_GZIP="true"

# ============================================
# Frontend / API URLs
# ============================================

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:3000"

# API Base URL (used by frontend)
API_BASE_URL="http://localhost:8000"

# CORS Origins (comma-separated)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000"

# ============================================
# Database Configuration
# ============================================

# PostgreSQL Connection String
# Format: postgresql://user:password@host:port/database?schema=public
DATABASE_URL="postgresql://bingsu_user:bingsu_password@localhost:5433/bingsu_db?schema=public"

# PostgreSQL Docker credentials (if using Docker)
POSTGRES_USER="bingsu_user"
POSTGRES_PASSWORD="bingsu_password"
POSTGRES_DB="bingsu_db"
POSTGRES_PORT="5433"

# ============================================
# Qdrant Vector Database
# ============================================

QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=""  # Optional, for cloud Qdrant
QDRANT_COLLECTION="documents"
QDRANT_DISTANCE="Cosine"
QDRANT_TOP_K="6"

# ============================================
# Redis Cache & Queue
# ============================================

REDIS_URL="redis://localhost:6379"
RATE_LIMIT_REDIS_PREFIX="rate"

# Upload Queue Mode: "redis" or "memory"
UPLOAD_QUEUE_MODE="redis"

# ============================================
# JWT Authentication
# ============================================

# JWT Secret Key (CHANGE THIS IN PRODUCTION!)
# Generate a random string: openssl rand -hex 32
JWT_SECRET_KEY="your-secret-key-here-change-this-in-production"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES="30"
JWT_REFRESH_TOKEN_EXPIRE_DAYS="7"
JWT_ISSUER="bingsu-api"
JWT_AUDIENCE="bingsu-client"

# ============================================
# Rate Limiting
# ============================================

RATE_LIMIT_WINDOW_MS="60000"  # 1 minute
RATE_LIMIT_MAX="120"  # requests per window

# ============================================
# Embeddings Service
# ============================================

# Embedding Provider: "openai" or "gemini"
EMBEDDING_PROVIDER="openai"

# OpenAI Embeddings
EMBEDDING_BASE_URL="https://api.openai.com/v1"
EMBEDDING_API_KEY="your-openai-api-key"
EMBEDDING_MODEL="text-embedding-3-small"  # or "text-embedding-3-large"
EMBEDDING_BATCH_SIZE="32"
EMBEDDING_TIMEOUT_MS="10000"
EMBEDDING_CONNECT_TIMEOUT_MS="30000"

# Gemini Embeddings (if using)
GEMINI_API_KEY="your-gemini-api-key"
# EMBEDDING_MODEL="models/gemini-embedding-001"  # if using Gemini

# ============================================
# RAG (Retrieval-Augmented Generation)
# ============================================

RAG_TIMEOUT_MS="2000"
RAG_QUERY_VARIANT_LIMIT="4"
# RAG_QUERY_SYNONYMS='{"skill": ["ความสามารถ", "ทักษะ"]}'  # JSON format

# ============================================
# OCR Service
# ============================================

# OCR Service URL
OCR_API_URL="http://localhost:8001"

# Enable/Disable OCR
OCR_ENABLED="true"

# OCR Configuration
OCR_LANG="th"                    # Language code (th, en, etc.)
OCR_MAX_PAGES="30"              # Maximum pages to process
OCR_DPI="200"                   # DPI for PDF rendering
OCR_USE_ANGLE_CLS="true"        # Use angle classification
OCR_MIN_TEXT_CHARS="200"        # Minimum text chars to trigger OCR

# OCR Provider: "paddle" or "typhoon"
OCR_PROVIDER="paddle"

# Typhoon OCR API Key (if using typhoon provider)
TYPHOON_OCR_API_KEY=""

# ============================================
# Chat / LLM Configuration
# ============================================

# OpenAI Gateway (for chat)
GATEWAY_BASE_URL="https://aigateway.ntictsolution.com/v1"
OPENAI_API_KEY="your-openai-api-key"
OPENAI_MODEL="gpt-4o-mini"

# Chat Timeout
CHAT_TIMEOUT_MS="30000"
GATEWAY_CONNECT_TIMEOUT_MS="30000"

# Chat Parameters
CHAT_TEMPERATURE="0.7"
CHAT_MAX_TOKENS="4000"

# ============================================
# File Upload Configuration
# ============================================

# Allowed file types
ALLOWED_UPLOAD_MIME_TYPES="application/pdf,text/plain,text/markdown"
ALLOWED_UPLOAD_EXTENSIONS=".pdf,.txt,.md"

# File size limits
MAX_UPLOAD_FILE_MB="200"        # Maximum file size in MB
MAX_UPLOAD_PART_MB="20"         # Maximum part size for chunked upload

# Store original files (true/false)
STORE_RAW_FILES="true"

# File Storage Provider: "local" or "s3"
FILE_STORAGE_PROVIDER="local"

# ============================================
# S3 Storage (if using S3)
# ============================================

S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET=""
S3_PUBLIC_URL=""
S3_FORCE_PATH_STYLE="true"

# ============================================
# Text Processing
# ============================================

TEXT_CHUNK_SIZE="1800"
TEXT_CHUNK_OVERLAP="100"
PDF_SPLIT_PAGE_THRESHOLD="400"
PDF_PAGES_PER_CHUNK="50"

# ============================================
# Email Configuration (Optional)
# ============================================

# SMTP Configuration
SMTP_SERVER="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
EMAIL_FROM="noreply@bingsu.com"

# Email Verification
REQUIRE_EMAIL_VERIFICATION="false"
EMAIL_VERIFICATION_TOKEN_TTL_HOURS="24"
PASSWORD_RESET_TOKEN_TTL_HOURS="2"

# Auto-approve signups (for development)
ALLOW_SIGNUP_AUTO_APPROVE="false"

# ============================================
# Session Configuration
# ============================================

SESSION_TTL_DAYS="30"

# ============================================
# Cache Configuration
# ============================================

CACHE_TTL_SECONDS="30"

# ============================================
# Logging
# ============================================

# Log Level: "DEBUG", "INFO", "WARNING", "ERROR"
LOG_LEVEL="INFO"

# ============================================
# Production Settings
# ============================================

# Set to "production" in production
NODE_ENV="development"

# ============================================
# Service URLs (for inter-service communication)
# ============================================

# OCR Service
OCR_SERVICE_URL="http://localhost:8001"

# Embeddings Service (if separate)
EMBEDDINGS_SERVICE_URL="http://localhost:8002"

# RAG Service (if separate)
RAG_SERVICE_URL="http://localhost:8003"

# ============================================
# Notes
# ============================================
# 1. Change JWT_SECRET_KEY in production!
# 2. Use strong passwords for databases
# 3. Enable SSL/TLS in production
# 4. Configure CORS properly for your domain
# 5. Use environment variables for all secrets
# 6. Never commit .env files to git
